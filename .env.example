# 시세 공급자 선택: mock | datagokr
# - mock     : API 키 없이 동작하는 가짜 시세 (기본값)
# - datagokr : 공공데이터포털 금융위원회 「주식시세정보」 실제 시세
MARKET_DATA_PROVIDER=mock

# 공공데이터포털 인증키 (MARKET_DATA_PROVIDER=datagokr 일 때, 그리고 npm run seed 에 필요)
# 발급: https://www.data.go.kr/data/15094808/openapi.do
# Decoding 키를 그대로 넣으세요.
DATA_GO_KR_SERVICE_KEY=

# /api/revalidate 인증용 시크릿 (배포 환경에만 필요)
# Vercel 에 이 이름으로 설정하면 cron 요청에 Authorization 헤더가 자동으로 붙는다.
# 생성 예: openssl rand -hex 16
CRON_SECRET=
